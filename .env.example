# ============================================================================
# Market Pulse — environment configuration
# Copy this file to .env and fill in values. Only ANTHROPIC_API_KEY is
# required to run the app end to end.
# ============================================================================

# --- REQUIRED ---

# Your Anthropic API key. Get one at https://console.anthropic.com/
# Used for: the agent loop, native web search tool, router classification,
# grounding verification, and the LLM-as-judge eval pass.
ANTHROPIC_API_KEY=sk-ant-...

# --- OPTIONAL: fallback search provider ---
# Only needed if the native Anthropic web_search tool is unavailable on
# your API key/org (e.g. disabled by an admin, or an older account tier).
# The app auto-detects this and falls back automatically; you only need
# ONE of these set. Both have generous free tiers as of writing:
#   Tavily: https://tavily.com  (free tier: 1,000 searches/month)
#   Exa:    https://exa.ai      (free tier: 1,000 searches/month, credit-based)
TAVILY_API_KEY=
EXA_API_KEY=

# Force the fallback search path even if native web search is available.
# Useful for testing/demoing the fallback architecture. Default: false.
FORCE_FALLBACK_SEARCH=false

# --- OPTIONAL: model selection ---
# Defaults are sensible; override if you want to trade cost/speed/quality.
AGENT_MODEL=claude-sonnet-4-6
ROUTER_MODEL=claude-haiku-4-5-20251001
GROUNDING_MODEL=claude-haiku-4-5-20251001
JUDGE_MODEL=claude-sonnet-4-6

# --- OPTIONAL: tool-selection strategy ---
# "router" (default) or "agentic". See README "Agentic vs. router" section
# for the eval numbers behind this default. Per-request overrides are also
# available via the API's strategy_override field / the frontend's
# advanced panel.
TOOL_STRATEGY=router

# --- OPTIONAL: web search limits ---
WEB_SEARCH_MAX_USES=5

# --- OPTIONAL: rate limiting (per client session/IP) ---
RATE_LIMIT_REQUESTS_PER_MINUTE=10
RATE_LIMIT_REQUESTS_PER_DAY=200

# --- OPTIONAL: guardrails ---
MAX_QUESTION_LENGTH=500

# --- OPTIONAL: cost estimation ---
PRICE_PER_1K_WEB_SEARCHES=10.0

# --- OPTIONAL: logging ---
LOG_DIR=./logs

# ============================================================================
# Frontend-only (see frontend/.env.example) — not read by the backend.
# FRONTEND_API_BASE_URL is used by docker-compose to bake the backend URL
# into the frontend's production build.
# ============================================================================
FRONTEND_API_BASE_URL=http://localhost:8000
